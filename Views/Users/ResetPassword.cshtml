@using Microsoft.AspNetCore.Identity;
@inject UserManager<ApplicationUser> _userManager;

@model PaletsWebApp.ViewModels.ResetPasswordVM

@{
    ViewData["Title"] = "Cambiar contraseña";

    var loggedInUser = _userManager.Users?.FirstOrDefault(x => x.UserName == User.Identity!.Name);

    bool isAdmin = false;
    if (loggedInUser != null &&
        (await _userManager.IsInRoleAsync(loggedInUser, "Admin") ||
         await _userManager.IsInRoleAsync(loggedInUser, "Supervisor")))
    {
        isAdmin = true;
    }

}

<div class="container-fluid">

    @if (isAdmin)
    {
        <a class="btn btn-primary mb-1" asp-action="Index" asp-controller="Users">Regresar</a>    
    }
    
    <div class="card">
        <div class="card-header bg-primary">
            <h4 class="card-title text-white">Cambiar contraseña</h4>
        </div>
        <div class="card-body">
            
             <form asp-action="ResetPassword" asp-controller="Users">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserName" />
                <input type="hidden" asp-for="UserFullName" />

                <div class="mb-2">
                    <label>Nombre completo</label>
                    <input type="text" asp-for="UserFullName" class="form-control" disabled />
                    <span asp-validation-for="UserFullName" class="text-danger"></span>
                </div>

                <div class="mb-2">
                    <label>Usuario</label>
                    <input type="text" asp-for="UserName" class="form-control" disabled />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="mb-2">
                    <label>Nueva Contraseña</label>
                    <input type="password" asp-for="NewPassword" autocomplete="off" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label>Confirmar Contraseña</label>
                    <input type="password" asp-for="ConfirmPassword" autocomplete="off" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                
                <div class="mb-2">

                    <button type="submit"
                            class="btn btn-primary"
                            id="btnAceptar"
                            name="submit" value="aceptar">
                        Cambiar
                    </button>

                </div>
            </form>
        </div>
    </div>
</div>


