@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> _userManager
@model PaletsWebApp.ViewModels.ResetPasswordVM

@{
    ViewData["Title"] = "Cambiar contraseña";
    var loggedInUser = _userManager.Users?.FirstOrDefault(x => x.UserName == User.Identity!.Name);
    var isAdmin = loggedInUser != null &&
        (await _userManager.IsInRoleAsync(loggedInUser, "Admin") ||
         await _userManager.IsInRoleAsync(loggedInUser, "Supervisor"));
}

<link rel="stylesheet" href="~/css/user-forms.css" asp-append-version="true" />

<div class="page-header">
    <div>
        <h1 class="page-title">Cambiar contraseña</h1>
        <p class="page-subtitle">Define una nueva contraseña para la cuenta seleccionada.</p>
    </div>
    @if (isAdmin)
    {
        <a class="btn btn-outline-secondary" asp-action="Index" asp-controller="Users">
            <i class="bi bi-arrow-left me-2"></i>Cancelar
        </a>
    }
</div>

<form asp-action="ResetPassword" asp-controller="Users" method="post" class="user-form password-form">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="UserName" />
    <input type="hidden" asp-for="UserFullName" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="user-form-layout password-form-layout">
        <section class="surface user-form-section">
            <div class="user-form-heading">
                <span class="user-form-icon user-form-icon-access"><i class="bi bi-key"></i></span>
                <div>
                    <h2>Nueva contraseña</h2>
                    <p>Actualiza las credenciales de acceso del usuario.</p>
                </div>
            </div>

            <div class="user-account-card">
                <span class="user-account-avatar"><i class="bi bi-person"></i></span>
                <div>
                    <strong>@Model.UserFullName</strong>
                    <small>@Model.UserName</small>
                </div>
            </div>

            <div class="user-form-grid password-fields">
                <div class="field">
                    <label asp-for="NewPassword">Nueva contraseña <span class="required-mark">*</span></label>
                    <div class="password-input">
                        <input asp-for="NewPassword" type="password" autocomplete="new-password" class="form-control" placeholder="Nueva contraseña" />
                        <button type="button" class="password-toggle" data-password-toggle="NewPassword" aria-label="Mostrar contraseña">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword">Confirmar contraseña <span class="required-mark">*</span></label>
                    <div class="password-input">
                        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="form-control" placeholder="Repite la contraseña" />
                        <button type="button" class="password-toggle" data-password-toggle="ConfirmPassword" aria-label="Mostrar contraseña">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
        </section>

        <aside class="surface user-form-aside">
            <div class="user-form-heading">
                <span class="user-form-icon user-form-icon-summary"><i class="bi bi-shield-check"></i></span>
                <div>
                    <h2>Seguridad</h2>
                    <p>Confirma el cambio antes de continuar.</p>
                </div>
            </div>
            <div class="user-form-notice">
                <i class="bi bi-info-circle"></i>
                <p>Usa una contraseña difícil de adivinar y verifica que ambos campos coincidan.</p>
            </div>
            <div class="user-form-actions">
                @if (isAdmin)
                {
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                }
                <button type="submit" class="btn btn-primary" id="btnAceptar" name="submit" value="aceptar">
                    <i class="bi bi-key me-1"></i>Cambiar contraseña
                </button>
            </div>
        </aside>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-password-toggle]').forEach(button => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.dataset.passwordToggle);
                if (!input) return;
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                button.querySelector('i')?.classList.toggle('bi-eye', !show);
                button.querySelector('i')?.classList.toggle('bi-eye-slash', show);
                button.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
            });
        });
    </script>
}