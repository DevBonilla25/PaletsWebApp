@using PaletsWebApp.Utilites
@model PaginatedList<PaletsWebApp.Models.View_User>

@{
    ViewData["Title"] = "Usuarios";
    var currentStatus = ViewData["filterEstado"]?.ToString() ?? "-1";
    var currentRole = ViewData["filterRol"]?.ToString() ?? "-1";
    var pageSize = (int?)ViewData["PageSize"] ?? 15;
    var rowNumber = ((Model.PageIndex - 1) * pageSize) + 1;
}

<div class="page-header">
    <div><h1 class="page-title">Gestión de usuarios</h1><p class="page-subtitle">Administra usuarios, roles y acceso al sistema.</p></div>
    <a class="btn btn-primary" asp-action="Register"><i class="bi bi-person-plus me-2"></i>Nuevo usuario</a>
</div>

<form asp-action="Index" method="get" class="surface filter-panel">
    <input type="hidden" name="pageSize" value="@pageSize" />
    <div class="filter-grid">
        <div><label>Nombre</label><input class="form-control" name="sUser" value="@ViewData["filterUser"]" placeholder="Buscar usuario..." /></div>
        <div>
            <label>Rol</label>
            <select class="form-select" name="sRol">
                <option value="-1">Todos</option>
                @foreach (var role in new[] { "Admin", "Supervisor", "Cliente", "Bodeguero", "Chofer", "Invitado" })
                {
                    <option value="@role" selected="@(currentRole == role)">@role</option>
                }
            </select>
        </div>
        <div>
            <label>Estado</label>
            <select class="form-select" name="sEstado">
                <option value="-1">Todos</option>
                <option value="true" selected="@(currentStatus == "true")">Activo</option>
                <option value="false" selected="@(currentStatus == "false")">Inactivo</option>
            </select>
        </div>
        <div class="d-flex gap-2"><button class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Buscar</button><a class="btn btn-outline-secondary"
            asp-action="Index" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a></div>
    </div>
</form>

<div class="surface data-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>#</th><th>Usuario</th><th>Contacto</th><th>Rol</th><th>Estado</th><th>Creación</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var initials = $"{item.Nombres?.FirstOrDefault()}{item.Apellidos?.FirstOrDefault()}".ToUpper();
                    <tr>
                        <td class="row-index">@rowNumber</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar">@initials</span>
                                <span>
                                    <strong>@item.Nombres @item.Apellidos</strong>
                                    <small class="d-block text-muted">@item.UserName</small>
                                </span>
                            </div>
                        </td>
                        <td>@item.Email<small class="d-block text-muted">@item.Telefono</small></td>
                        <td><span class="status-badge status-neutral">@item.RolName</span></td>
                        <td><span class="badge @Utils.BadgeUser(item.Activo)">@Utils.EstatusUser(item.Activo)</span></td>
                        <td>@Utils.FormatDate(item.FechaCreacion)</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary"
                            asp-action="Editar"
                            asp-route-id="@item.Id"><i class="bi bi-pencil"></i></a> <a class="btn btn-sm btn-outline-secondary"
                            asp-action="ResetPassword"
                            asp-route-id="@item.Id" title="Cambiar contraseña"><i class="bi bi-key"></i></a></td>
                    </tr>
                    rowNumber++;
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7"><div class="empty-state"><i class="bi bi-people"></i>No se encontraron usuarios.</div></td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="pagination-bar">
        <div class="page-size">
            <span>Mostrar</span>
            <select class="form-select form-select-sm" data-page-size>
                @foreach (var size in new[] { 15, 25, 50 })
                {
                    <option value="@size" selected="@(pageSize == size)">@size</option>
                }
            </select>
            <span>registros</span>
        </div>
        <div class="btn-group">
            <a class="btn btn-outline-primary @(!Model.HasPreviousPage ? "disabled" : "")"
                asp-action="Index"
                asp-route-pageNumber="@(Model.PageIndex - 1)"
                asp-route-pageSize="@pageSize"
                asp-route-filterUser="@ViewData["filterUser"]"
                asp-route-filterRol="@ViewData["filterRol"]"
                asp-route-filterEstado="@ViewData["filterEstado"]">Anterior</a>
            <span class="btn btn-light disabled">@Model.PageIndex / @Math.Max(1, Model.TotalPages)</span>
            <a class="btn btn-outline-primary @(!Model.HasNextPage ? "disabled" : "")"
                asp-action="Index"
                asp-route-pageNumber="@(Model.PageIndex + 1)"
                asp-route-pageSize="@pageSize"
                asp-route-filterUser="@ViewData["filterUser"]"
                asp-route-filterRol="@ViewData["filterRol"]"
                asp-route-filterEstado="@ViewData["filterEstado"]">Siguiente</a>
        </div>
    </div>
</div>
