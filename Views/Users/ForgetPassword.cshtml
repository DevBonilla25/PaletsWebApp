@model PaletsWebApp.ViewModels.ForgetPasswordVM

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Olvido contraseña";
}

<div class="container-fluid" style=" max-width:550px;">
    
    <div class="card">
        <div class="card-header bg-primary">
            <h4 class="card-title text-white">Olvido de contraseña</h4>
        </div>
        <div class="card-body">
            <form asp-action="ForgetPassword" asp-controller="Users">

                <input type="hidden" asp-for="FromMobile" />

            @if (ViewBag.LinkEnviado)
            {
                <br />
                <label style="color:red;">Se han enviado a su email las instrucciones para recuperar su contraseña</label>

                <div class="row" style=" margin-top:20px;">

                    <div class="col-4">

                        @if (!ViewBag.FomMobile)
                        {
                            <a class="btn btn-primary mb-1" asp-action="Login" asp-controller="Users">Regresar</a>
                        }

                    </div>

                </div>
            
            }
            else
            {
                

                    <div class="mb-2">
                        <label>Ingrese su Email para recuperar su contraseña</label>
                        <input type="text" asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="row" style=" margin-top:20px;">

                        <div class="col-4">

                            @if (!ViewBag.FomMobile)
                            {
                                <a class="btn btn-primary mb-1" asp-action="Login" asp-controller="Users">Regresar</a>
                            }

                        </div>

                        <div class="mb-2 col-8">

                            <button type="submit"
                                    style="float: right;"
                                    class="btn btn-primary"
                                    id="btnAceptar"
                                    name="submit" value="aceptar">
                                Recuperar
                            </button>

                        </div>

                    </div>


            }

           </form>
            
        </div>
    </div>
</div>

