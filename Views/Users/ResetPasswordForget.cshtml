@model PaletsWebApp.ViewModels.ResetPasswordForgetViewModel

@{

    Layout = "_LoginLayout";

    ViewData["Title"] = "Cambiar contraseña";

   

}

<div class="container-fluid">

    
    <div class="card">
        <div class="card-header bg-primary">
            <h4 class="card-title text-white">Cambiar contraseña</h4>
        </div>
        <div class="card-body">
            
             <form asp-action="ResetPasswordForget" asp-controller="Users">

                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />
               
                @if (ViewBag.CambioExitoso)
                {
                    <label>La Contraseña se ha cambiado exitosamente</label>
                }
                else
                {
                    <div class="mb-2">
                        <label>Nueva Contraseña</label>
                        <input type="password" asp-for="NewPassword" autocomplete="off" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-2">
                        <label>Confirmar Contraseña</label>
                        <input type="password" asp-for="ConfirmPassword" autocomplete="off" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-2">

                        <button type="submit"
                                class="btn btn-primary"
                                id="btnAceptar"
                                name="submit" value="aceptar">
                            Cambiar
                        </button>
                    </div>

                }


                
            </form>
        </div>
    </div>
</div>

