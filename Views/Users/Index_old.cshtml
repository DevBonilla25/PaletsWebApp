@model List<PaletsWebApp.ViewModels.UserVM>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container-fluid">
    <a class="btn btn-primary mb-1" asp-action="Register" asp-controller="Users">Adicionar Usuario</a>
    <div class="card">
        <div class="card-header bg-primary" >
            <h4 class="card-title text-white">Lista de Usuarios</h4>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover" id="myTable">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Apellidos</th>
                        <th>UserName</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var user in Model)
                    {
                        <tr>
                            <td>@user.Nombres</td>
                            <td>@user.Apellidos</td>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td>
                                <a class="btn btn-info" asp-action="ResetPassword" asp-controller="Users" asp-route-id="@user.Id">Cambiar Contraseña</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

