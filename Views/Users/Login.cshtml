@model PaletsWebApp.ViewModels.LoginVM

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";

    bool activeUser = ViewBag.Activo == false ? false : true;

} 

<!-- Outer Row -->
<div class="row justify-content-center">

    <div class="col-xl-10 col-lg-12 col-md-9">

        <div class="card o-hidden border-0 shadow-lg my-5">
            <div class="card-body p-0">
                <!-- Nested Row within Card Body -->
                <div class="row">
                    <div class="col-lg-12 d-none d-lg-block bg-login-image"></div>
                    <div class="col-lg-12">
                        <div class="p-5  dv-login">

                            <div class="text-center">
                                <img class="img-fluid" src="~/PSLogotipoFBInit.png" >
                            </div>

                            <div class="text-center">
                                <h1 class="h4 text-gray-900 mb-4">Iniciar sesión</h1>
                            </div>
                            <form class="user" method="post" asp-action="Login">
                                <div class="form-group">
                                    <input asp-for="Username" type="text" class="form-control form-control-user"
                                           id="exampleInputEmail" aria-describedby="emailHelp"
                                           placeholder="Ingrese el usuario...">
                                      <span asp-validation-for="Username" class="text-danger"></span>

                                    @if (!activeUser)
                                    {
                                        <labe style="color:red;">Cuenta Inactivada</labe>   
                                    
                                     }

                                </div>
                                <div class="form-group">
                                    <input asp-for="Password" type="password" class="form-control form-control-user"
                                           id="exampleInputPassword" placeholder="Password">
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                                <div class="form-group" style="text-align: left;margin-top: 5px; display:none;">
                                    <div class="custom-control custom-checkbox small">
                                        <input asp-for="RememberMe" type="checkbox" class="custom-control-input" id="customCheck">
                                        <label class="custom-control-label" for="customCheck">
                                            Recordarme
                                        </label>
                                    </div>
                                </div>
                                <input type="submit" class="btn btn-primary btn-user btn-block" style=" margin-top:15px;" value="Login">
                                
                            </form>
                            <hr>
                            <div class="text-center">
                                <a class="small" asp-action="ForgetPassword" asp-controller="Users" >Olvido su contraseña?</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>