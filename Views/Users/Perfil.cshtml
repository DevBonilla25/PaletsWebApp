@using Microsoft.AspNetCore.Identity;
@inject UserManager<ApplicationUser> _userManager;

@model PaletsWebApp.ViewModels.RegisterUserVM

@{
    ViewData["Title"] = "Editar Usuario";

    var loggedInUser = _userManager.Users?.FirstOrDefault(x => x.UserName == User.Identity!.Name);

    bool isAdmin = false;
    if (loggedInUser != null && await _userManager.IsInRoleAsync(loggedInUser, "Admin"))
    {
        isAdmin = true;
    }

}

<div class="container-fluid">
    
    @if (isAdmin)
    {
        <a class="btn btn-primary mb-1" asp-action="Index" asp-controller="Users">Regresar</a>
    }
    
    <div class="card">
        <div class="card-header bg-primary">
            <h4 class="card-title text-white">Editar Perfil</h4>
        </div>
        <div class="card-body">
            
             <form asp-action="Perfil" asp-controller="Users">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="UserName" />
                <input type="hidden" asp-for="Rol" />
                <input type="hidden" asp-for="Password" />

                <div class="row">

                    <div class="col-6">
                        <div class="mb-2">

                            <label>Nombres</label>

                            <input type="text" asp-for="Nombres" class="form-control"  />
                            <span asp-validation-for="Nombres" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="mb-2">
                           
                            <label>Apellidos</label>
                           

                            <input type="text" asp-for="Apellidos" class="form-control"  />
                            <span asp-validation-for="Apellidos" class="text-danger"></span>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-6">
                        <div class="mb-2">
                           
                           <label>Tipo de documento</label>
                           
                            @Html.DropDownListFor(m=> m.TipoDocumento,new SelectList(Model.TiposDocumentosList, "Value", "Text"), "-seleccione-" , new{@class = "form-control"})
                            <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="mb-2">

                            <label>Documento</label>
                            
                            <input type="text" asp-for="Documento" class="form-control"  />
                            <span asp-validation-for="Documento" class="text-danger"></span>
                        </div>
                    </div>

                </div>

                <div class="row">

                    <div class="col-6">
                        <div class="mb-2">
                            <label>Email</label>
                            <input type="text" asp-for="Email" readonly="true" class="form-control" />
                            <span asp-validation-for="Email"  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="mb-2">
                            <label>Teléfono</label>
                            <input type="text" asp-for="Telefono" class="form-control"  />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="mb-2">
                            <label>Dirección</label>
                            <textarea id="richEditor" asp-for="Direccion" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-2">
                    <button type="submit"
                            class="btn btn-primary"
                            id="btnAceptar"
                            name="submit" value="aceptar">
                        Guardar
                    </button>

                </div>
            </form>
        </div>
    </div>
</div>


