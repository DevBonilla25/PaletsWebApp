@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> _userManager
@model PaletsWebApp.ViewModels.RegisterUserVM

@{
    ViewData["Title"] = "Mi perfil";
    var loggedInUser = _userManager.Users?.FirstOrDefault(x => x.UserName == User.Identity!.Name);
    var isAdmin = loggedInUser != null &&
        (await _userManager.IsInRoleAsync(loggedInUser, "Admin") ||
         await _userManager.IsInRoleAsync(loggedInUser, "Supervisor"));
}

<link rel="stylesheet" href="~/css/user-forms.css" asp-append-version="true" />

<div class="page-header">
    <div>
        <h1 class="page-title">Mi perfil</h1>
        <p class="page-subtitle">Consulta y actualiza tu información personal.</p>
    </div>
    @if (isAdmin)
    {
        <a class="btn btn-outline-secondary" asp-action="Index" asp-controller="Users">
            <i class="bi bi-arrow-left me-2"></i>Volver a usuarios
        </a>
    }
</div>

<form asp-action="Perfil" asp-controller="Users" method="post" class="user-form">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="UserName" />
    <input type="hidden" asp-for="Rol" />
    <input type="hidden" asp-for="Password" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="user-form-layout">
        <div class="user-form-content">
            <section class="surface user-form-section">
                <div class="user-form-heading">
                    <span class="user-form-icon user-form-icon-person"><i class="bi bi-person"></i></span>
                    <div>
                        <h2>Información personal</h2>
                        <p>Mantén actualizados tus datos de identificación.</p>
                    </div>
                </div>

                <div class="user-form-grid">
                    <div class="field">
                        <label asp-for="Nombres">Nombres <span class="required-mark">*</span></label>
                        <input asp-for="Nombres" autocomplete="given-name" class="form-control" />
                        <span asp-validation-for="Nombres" class="text-danger"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Apellidos">Apellidos <span class="required-mark">*</span></label>
                        <input asp-for="Apellidos" autocomplete="family-name" class="form-control" />
                        <span asp-validation-for="Apellidos" class="text-danger"></span>
                    </div>
                    <div class="field">
                        <label asp-for="TipoDocumento">Tipo de documento <span class="required-mark">*</span></label>
                        <select asp-for="TipoDocumento" asp-items="Model.TiposDocumentosList" class="form-select">
                            <option value="">Selecciona un tipo</option>
                        </select>
                        <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Documento">Documento <span class="required-mark">*</span></label>
                        <input asp-for="Documento" autocomplete="off" class="form-control" />
                        <span asp-validation-for="Documento" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <section class="surface user-form-section">
                <div class="user-form-heading">
                    <span class="user-form-icon user-form-icon-access"><i class="bi bi-telephone"></i></span>
                    <div>
                        <h2>Contacto</h2>
                        <p>Información utilizada para identificar y contactar tu cuenta.</p>
                    </div>
                </div>

                <div class="user-form-grid">
                    <div class="field">
                        <label asp-for="Email">Correo electrónico</label>
                        <div class="profile-readonly-field">
                            <i class="bi bi-envelope"></i>
                            <span>@Model.Email</span>
                            <small>No editable</small>
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Telefono">Teléfono</label>
                        <input asp-for="Telefono" type="tel" autocomplete="tel" class="form-control" placeholder="Número de teléfono" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                    <div class="field user-form-span-2">
                        <label asp-for="Direccion">Dirección</label>
                        <textarea asp-for="Direccion" autocomplete="street-address" class="form-control user-address" rows="3" placeholder="Dirección de contacto"></textarea>
                        <span asp-validation-for="Direccion" class="text-danger"></span>
                    </div>
                </div>
            </section>
        </div>

        <aside class="surface user-form-aside">
            <div class="user-form-heading">
                <span class="user-form-icon user-form-icon-summary"><i class="bi bi-person-check"></i></span>
                <div>
                    <h2>Tu cuenta</h2>
                    <p>Información general de acceso.</p>
                </div>
            </div>

            <div class="profile-account-summary">
                <span class="user-account-avatar"><i class="bi bi-person"></i></span>
                <div>
                    <strong>@Model.FullName</strong>
                    <small>@@@Model.UserName</small>
                </div>
            </div>

            <div class="user-form-notice">
                <i class="bi bi-info-circle"></i>
                <p>El correo electrónico y el usuario no pueden modificarse desde esta pantalla.</p>
            </div>

            <div class="user-form-actions">
                @if (isAdmin)
                {
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                }
                <button type="submit" class="btn btn-primary" id="btnAceptar" name="submit" value="aceptar">
                    <i class="bi bi-floppy me-1"></i>Guardar cambios
                </button>
            </div>
        </aside>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}