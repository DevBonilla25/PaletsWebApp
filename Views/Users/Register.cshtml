@model PaletsWebApp.ViewModels.RegisterUserVM

@{
    ViewData["Title"] = "Registrar Usuario";
}

<div class="container-fluid">
    <a class="btn btn-primary mb-1" asp-action="Index" asp-controller="Users">Regresar</a>
    <div class="card">
        <div class="card-header bg-primary" >
            <h4 class="card-title text-white">Registrar Usuario</h4>
        </div>
        <div class="card-body">
            <form asp-action="Register" asp-controller="Users">
                <div class="mb-2">
                    <label>Nombre</label>
                    <input type="text" asp-for="Nombres" autocomplete="off" class="form-control" />
                    <span asp-validation-for="Nombres" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label>Apellidos</label>
                    <input type="text" asp-for="Apellidos" autocomplete="off" class="form-control" />
                    <span asp-validation-for="Apellidos" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label>Email</label>
                    <input type="email" asp-for="Email" autocomplete="off" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label>Usuario</label>
                    <input type="text" asp-for="UserName" autocomplete="off" class="form-control" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label>Contraseña</label>
                    <input type="password" asp-for="Password" autocomplete="off" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-6">
                        <div class="mb-2">

                            
                            <label>Tipo de documento</label>
                            

                            @Html.DropDownListFor(m=> m.TipoDocumento,new SelectList(Model.TiposDocumentosList, "Value", "Text"), "-seleccione-" , new{@class = "form-control"})
                            <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="mb-2">

                            <label>Documento</label>


                            <input type="text" asp-for="Documento" autocomplete="off" class="form-control" />
                            <span asp-validation-for="Documento" class="text-danger"></span>
                        </div>
                    </div>

                </div>


                <div class="row">
                    <div class="col-12">
                        <div class="mb-2">


                            <label>Razon Social</label>
                            <input type="text" asp-for="RazonSocial" autocomplete="off" class="form-control" />
                            <span asp-validation-for="RazonSocial" class="text-danger"></span>

                           
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="mb-2">

                            
                            <label>Rol</label>

                            @Html.DropDownListFor(m=> m.Rol,new SelectList(Model.RolesList, "Value", "Text"), "-seleccione-" , new{@class = "form-control"})
                            <span asp-validation-for="Rol" class="text-danger"></span>

                        </div>
                    </div>

                </div>



                <div class="mb-2">
                    
                    <button type="submit"
                            class="btn btn-primary"
                            id="btnAceptar"
                            name="submit" value="aceptar">
                        Registrar
                    </button>

                </div>
            </form>
        </div>
    </div>
</div>