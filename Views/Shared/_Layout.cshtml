@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var roles = currentUser == null ? new List<string>() : (await UserManager.GetRolesAsync(currentUser)).ToList();
    var isAdmin = roles.Contains("Admin") || roles.Contains("Supervisor");
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string name) => controller.Equals(name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var initials = string.Join("", new[] { currentUser?.Nombres, currentUser?.Apellidos }.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x![0])).ToUpper();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Pallets Bonilla</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-box-seam"></i></span>
                <span><strong>Pallets</strong><small>Ferretería Bonilla</small></span>
            </a>
            <nav class="sidebar-nav" aria-label="Navegación principal">
                <a class="@Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
                <a class="@Active("Palets")" asp-controller="Palets" asp-action="Index"><i class="bi bi-box-seam"></i><span>Pallets</span></a>
                <a class="@Active("Transfers")"
                    asp-controller="Transfers"
                    asp-action="Index"><i class="bi bi-arrow-left-right"></i><span>Transferencias</span></a>
                @if (isAdmin)
                {
                    <a class="@Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i><span>Usuarios</span></a>
                }
                <div class="nav-separator"></div>
                <a asp-controller="Users" asp-action="Perfil"><i class="bi bi-person"></i><span>Mi perfil</span></a>
            </nav>
            <div class="sidebar-user">
                <span class="avatar">@(string.IsNullOrEmpty(initials) ? "U" : initials)</span>
                <span><strong>@currentUser?.Nombres @currentUser?.Apellidos</strong><small>@roles.FirstOrDefault()</small></span>
            </div>
        </aside>
        <div class="sidebar-backdrop" data-sidebar-close></div>
        <section class="app-main">
            <header class="app-topbar">
                <button class="icon-button" type="button" data-sidebar-toggle aria-label="Abrir menú"><i class="bi bi-list"></i></button>
                <div class="ms-auto dropdown">
                    <button class="user-menu" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">@(string.IsNullOrEmpty(initials) ? "U" : initials)</span>
                        <span class="user-menu-copy"><strong>@currentUser?.Nombres @currentUser?.Apellidos</strong><small>@roles.FirstOrDefault()</small></span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" asp-controller="Users" asp-action="Perfil"><i class="bi bi-person me-2"></i>Mi perfil</a></li>
                        <li><a class="dropdown-item"
                            asp-controller="Users"
                            asp-action="ResetPassword"
                            asp-route-id="@currentUser?.Id"><i class="bi bi-key me-2"></i>Cambiar contraseña</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><form
                            asp-controller="Users"
                            asp-action="Logout" method="post"><button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</button></form></li>
                    </ul>
                </div>
            </header>
            <main class="app-content">@RenderBody()</main>
        </section>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("Notyf")
</body>
</html>
