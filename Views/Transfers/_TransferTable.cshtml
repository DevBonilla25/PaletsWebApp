@using PaletsWebApp.Utilites
@model PaginatedList<PaletsWebApp.Models.View_Transferencia>

@{
    var pageSize = (int?)ViewData["PageSize"] ?? 15;
    var rowNumber = ((Model.PageIndex - 1) * pageSize) + 1;
}

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Transferencia</th>
                <th>Envía</th>
                <th>Recibe</th>
                <th>Estado</th>
                <th>Fecha de envío</th>
                <th>Fecha recibido</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="row-index">@rowNumber</td>
                    <td>
                        <strong>@item.CodigoInterno</strong>
                        <small class="d-block text-muted">ID #@item.Id</small>
                    </td>
                    <td>@item.UserEnviaFullName</td>
                    <td>@item.UserRecibeFullName</td>
                    <td>
                        <span class="badge @Utils.BadgeTransfer(item.DescEstado ?? "")">
                            @item.DescEstado
                        </span>
                    </td>
                    <td>@Utils.FormatDate(item.FechaEnvio)</td>
                    <td>@(item.FechaRecibo > DateTime.MinValue.AddYears(1) ? Utils.FormatDate(item.FechaRecibo) : "—")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Detalle"
                           asp-route-id="@item.Id">
                            <i class="bi bi-eye me-1"></i>Detalles
                        </a>
                    </td>
                </tr>
                rowNumber++;
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8">
                        <div class="empty-state">
                            <i class="bi bi-arrow-left-right"></i>
                            No se encontraron transferencias.
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
