@model PaletsWebApp.ViewModels.TransferenciaVM
<link rel="stylesheet" href="~/css/transfer-forms.css" asp-append-version="true" />
@using System.Text.Json
@using PaletsWebApp.Utilites

@{
    ViewData["Title"] = "Reclamar pallets";
    var results = ViewBag.ResultadosBusqueda as List<PaletsWebApp.ViewModels.PaletVM> ?? new();
    var searchTerm = ViewData["filterDescripcion"]?.ToString();
}

<div class="surface claim-workspace">
    <header class="claim-titlebar">
        <a asp-action="Index" class="claim-back" aria-label="Regresar"><i class="bi bi-arrow-left"></i></a>
        <div><h1>Reclamar pallets</h1><p>Registra los pallets que recibiste o retiraste.</p></div>
    </header>

    <div class="claim-workspace-body">
        <section aria-labelledby="searchTitle">
            <h2 id="searchTitle" class="claim-section-title">Buscar pallets</h2>
            <form asp-action="Reclamar" method="get" id="claimSearchForm">
                <input type="hidden" id="selectedPaletIds" name="selectedPaletIds" value="@string.Join(",", Model.Palets.Select(x => x.Id))" />
                <div class="input-group claim-search">
                    <input id="sDescripcion" type="text" name="sDescripcion" value="@searchTerm" class="form-control"
                        placeholder="Ejemplo: Palet 196"
                        autocomplete="off" autofocus />
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Buscar</button>
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button type="button" class="btn btn-outline-secondary" id="clearClaimSearch"><i class="bi bi-x-lg me-1"></i>Limpiar</button>
                    }
                </div>
            </form>

            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <div class="claim-results-heading">
                    <span>Resultados para <strong>@searchTerm</strong></span>

                </div>
                <div class="claim-results-list">
                    @foreach (var pallet in results)
                    {
                        var alreadyClaimed = string.Equals(pallet.DescEstado, "Reclamado", StringComparison.OrdinalIgnoreCase);
                        <article class="claim-result">
                            <div class="claim-result-info">
                                <div class="claim-result-main">
                                    <strong>@pallet.Descripcion</strong>
                                    <span class="badge @Utils.BadgePalet(pallet.DescEstado ?? "")">@pallet.DescEstado</span>
                                    <span class="claim-result-owner">@(pallet.ApplicationUserName ?? "Responsable sin identificar")</span>
                                </div>
                                @if (alreadyClaimed)
                                {
                                    <small class="claim-blocked-message">Actualmente está en poder de otro usuario. Puedes incluirlo en este reclamo.</small>
                                }
                                @if (pallet.EsCorreccionCustodia)
                                {
                                    <small class="text-warning">Tiene una transferencia pendiente hacia @(pallet.ReceptorTransferenciaPendiente ?? "otro usuario"). Se enviará a revisión.</small>
                                }
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm add-claim-pallet" data-palet-id="@pallet.Id">
                                @(pallet.IsSelected ? "Agregado" : pallet.EsCorreccionCustodia ? "Reportar posesión" : "Agregar")
                            </button>
                        </article>
                    }
                    @if (!results.Any())
                    {
                        <div class="claim-empty-state"><i class="bi bi-search"></i><p class="mb-0">No se encontraron pallets con esa descripción.</p></div>
                    }
                </div>
            }
        </section>

        <section aria-labelledby="summaryTitle">
            <form asp-action="Reclamar" method="post" id="claimSubmitForm" class="claim-summary">
                <div class="claim-summary-heading">
                    <h2 id="summaryTitle" class="claim-section-title mb-0">Seleccionados</h2>
                    <span class="badge bg-secondary" id="selectedPalletCount">@Model.Palets.Count</span>
                </div>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <input type="hidden" id="claimSelectionJson" name="JsonPalets" value="@Model.JsonPalets" />
                <div id="selectedPalletList" class="claim-selected-list"></div>
                <div class="mt-3">
                    <label asp-for="Observaciones">Motivo del reclamo</label>
                    <textarea asp-for="Observaciones" class="form-control" rows="4" placeholder="Indica dónde recibiste o retiraste los pallets."></textarea>
                    <span asp-validation-for="Observaciones" class="text-danger"></span>
                </div>
                <div class="claim-actions">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary" id="btnReclamar">Enviar reclamo</button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const results = @Html.Raw(JsonSerializer.Serialize(results));
            let selected = @Html.Raw(JsonSerializer.Serialize(Model.Palets));
            const list = document.getElementById('selectedPalletList');
            const count = document.getElementById('selectedPalletCount');
            const submit = document.getElementById('btnReclamar');

            function sync() {
                selected.forEach(item => item.IsSelected = true);
                document.getElementById('claimSelectionJson').value = JSON.stringify(selected);
                document.getElementById('selectedPaletIds').value = selected.map(item => item.Id).join(',');
                count.textContent = selected.length;
                submit.disabled = selected.length === 0;
                document.querySelectorAll('.add-claim-pallet').forEach(button => {
                    const isSelected = selected.some(item => item.Id === Number(button.dataset.paletId));
                    button.disabled = isSelected;
                    button.textContent = isSelected ? 'Agregado' : 'Agregar';
                });
            }
            function render() {
                list.replaceChildren();
                if (!selected.length) list.innerHTML = '<div class="claim-selection-empty">Aún no has agregado pallets.</div>';
                selected.forEach(pallet => {
                    const item = document.createElement('div');
                    item.className = 'claim-selected-item';
                    const name = document.createElement('span');
                    name.textContent = pallet.Descripcion;
                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'claim-remove';
                    remove.textContent = '×';
                    remove.setAttribute('aria-label', `Quitar ${pallet.Descripcion}`);
                    remove.addEventListener('click', () => { selected = selected.filter(x => x.Id !== pallet.Id); render(); });
                    const hidden = document.createElement('input');
                    hidden.type = 'hidden'; hidden.name = 'UqChecked'; hidden.value = pallet.Id;
                    item.append(name, remove, hidden); list.appendChild(item);
                });
                sync();
            }
            document.querySelectorAll('.add-claim-pallet').forEach(button => button.addEventListener('click', () => {
                const pallet = results.find(x => x.Id === Number(button.dataset.paletId));
                if (pallet && !selected.some(x => x.Id === pallet.Id)) { selected.push(pallet); render(); }
            }));
            document.getElementById('claimSearchForm').addEventListener('submit', sync);
            document.getElementById('clearClaimSearch')?.addEventListener('click', () => {
                sync();
                const url = new URL('@Url.Action("Reclamar", "Transfers")', window.location.origin);
                const ids = document.getElementById('selectedPaletIds').value;
                if (ids) url.searchParams.set('selectedPaletIds', ids);
                window.location.href = url.toString();
            });
            render();
        })();
    </script>
}
