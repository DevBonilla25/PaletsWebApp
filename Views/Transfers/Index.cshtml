@using PaletsWebApp.Utilites
@model PaginatedList<PaletsWebApp.Models.View_Transferencia>

@{
    ViewData["Title"] = "Transferencias";
    var currentStatus = ViewData["filterEstado"]?.ToString() ?? "-1";
    var pageSize = (int?)ViewData["PageSize"] ?? 15;
    var rowNumber = ((Model.PageIndex - 1) * pageSize) + 1;
    var historyPallet = ViewBag.HistoryPallet as PaletsWebApp.Models.View_Palet;
    var isPalletHistory = historyPallet != null;
}

<div class="page-header">
    <div>
        <h1 class="page-title">@(isPalletHistory ? "Historial de transferencias" : "Transferencias")</h1>
        <p class="page-subtitle">@(isPalletHistory ? "Movimientos relacionados con el pallet seleccionado." : "Consulta y gestiona el movimiento de pallets.")</p>
    </div>
    @if (isPalletHistory)
    {
        <a class="btn btn-outline-secondary" asp-controller="Palets" asp-action="Index"><i class="bi bi-arrow-left me-2"></i>Volver a pallets</a>
    }
    else
    {
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Nueva transferencia</a>
            @if (ViewBag.CanReclaimPalets)
            {
                <a class="btn btn-outline-primary" asp-action="Reclamar"><i class="bi bi-exclamation-triangle me-1"></i>Reclamar pallets</a>
            }
        </div>
    }
</div>

@if (!isPalletHistory)
{
<form asp-action="Index" method="get" class="surface filter-panel">
    <input type="hidden" name="pageSize" value="@pageSize" />
    <div class="filter-grid">
        <div>
            <label>Envía</label>
            <input class="form-control" name="sUserEnvia" value="@ViewData["filterUserEnvia"]" placeholder="Usuario que envía..." />
        </div>
        <div>
            <label>Recibe</label>
            <input class="form-control" name="sUserRecibe" value="@ViewData["filterUserRecibe"]" placeholder="Usuario que recibe..." />
        </div>
        <div>
            <label>Estado</label>
            <select class="form-select" name="sEstado">
                <option value="-1">Todos</option>
                @foreach (var status in (IEnumerable<PaletsWebApp.Models.Catalogo>)ViewBag.EstadosTransferencia)
                {
                    <option value="@status.Id" selected="@(currentStatus == status.Id.ToString())">@status.Descripcion</option>
                }
            </select>
        </div>
        <div>
            <label>Pallet</label>
            <input class="form-control" name="sPalet" value="@ViewData["filterPalet"]" placeholder="Descripción del pallet..." />
        </div>
        <div>
            <label for="transferDateFrom">Desde</label>
            <div class="input-group date-filter">
                <input id="transferDateFrom" class="form-control js-transfer-date" name="sDate1" value="@ViewData["filterDate1"]"
                    placeholder="dd/MM/yyyy"
                    maxlength="10"
                    autocomplete="off"
                    inputmode="numeric" />
                <button type="button" class="btn btn-outline-secondary date-picker-trigger"
                    data-date-target="transferDateFrom"
                    aria-label="Abrir calendario desde"><i class="bi bi-calendar3"></i></button>
            </div>
        </div>
        <div>
            <label for="transferDateTo">Hasta</label>
            <div class="input-group date-filter">
                <input id="transferDateTo" class="form-control js-transfer-date" name="sDate2" value="@ViewData["filterDate2"]"
                    placeholder="dd/MM/yyyy"
                    maxlength="10"
                    autocomplete="off"
                    inputmode="numeric" />
                <button type="button" class="btn btn-outline-secondary date-picker-trigger"
                    data-date-target="transferDateTo"
                    aria-label="Abrir calendario hasta"><i class="bi bi-calendar3"></i></button>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Buscar</button>
            <a class="btn btn-outline-secondary" asp-action="Index" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
        </div>
    </div>
</form>
}
else
{
    <div class="pallet-history-context">
        <span class="history-icon"><i class="bi bi-clock-history"></i></span>
        <div>
            <small>Historial del pallet</small>
            <strong>@historyPallet!.Descripcion</strong>
            <span>Propietario actual: @historyPallet.UserFullName &middot; Estado: @historyPallet.DescEstado</span>
        </div>
    </div>
}

<div class="surface data-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Transferencia</th>
                    <th>Envía</th>
                    <th>Recibe</th>
                    <th>Estado</th>
                    <th>Fecha de envío</th>
                    <th>Fecha recibido</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="row-index">@rowNumber</td>
                        <td><strong>@item.CodigoInterno</strong><small class="d-block text-muted">ID #@item.Id</small></td>
                        <td>@item.UserEnviaFullName</td>
                        <td>@item.UserRecibeFullName</td>
                        <td><span class="badge @Utils.BadgeTransfer(item.DescEstado ?? "")">@item.DescEstado</span></td>
                        <td>@Utils.FormatDate(item.FechaEnvio)</td>
                        <td>@(item.FechaRecibo > DateTime.MinValue.AddYears(1) ? Utils.FormatDate(item.FechaRecibo) : "—")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@item.Id">
                                <i class="bi bi-eye me-1"></i>Detalles
                            </a>
                        </td>
                    </tr>
                    rowNumber++;
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8"><div class="empty-state"><i class="bi bi-arrow-left-right"></i>No se encontraron transferencias.</div></td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="pagination-bar">
        <div class="page-size">
            <span>Mostrar</span>
            <select class="form-select form-select-sm" data-page-size>
                @foreach (var size in new[] { 15, 25, 50 })
                {
                    <option value="@size" selected="@(pageSize == size)">@size</option>
                }
            </select>
            <span>registros</span>
        </div>
        <div class="btn-group">
            <a class="btn btn-outline-primary @(!Model.HasPreviousPage ? "disabled" : "")"
                asp-action="Index"
                asp-route-pageNumber="@(Model.PageIndex - 1)"
                asp-route-pageSize="@pageSize"
                asp-route-palletId="@ViewData["PalletId"]"
                asp-route-filterUserEnvia="@ViewData["filterUserEnvia"]"
                asp-route-filterUserRecibe="@ViewData["filterUserRecibe"]"
                asp-route-filterDate1="@ViewData["filterDate1"]"
                asp-route-filterDate2="@ViewData["filterDate2"]"
                asp-route-filterEstado="@ViewData["filterEstado"]"
                asp-route-filterPalet="@ViewData["filterPalet"]">Anterior</a>
            <span class="btn btn-light disabled">@Model.PageIndex / @Math.Max(1, Model.TotalPages)</span>
            <a class="btn btn-outline-primary @(!Model.HasNextPage ? "disabled" : "")"
                asp-action="Index"
                asp-route-pageNumber="@(Model.PageIndex + 1)"
                asp-route-pageSize="@pageSize"
                asp-route-palletId="@ViewData["PalletId"]"
                asp-route-filterUserEnvia="@ViewData["filterUserEnvia"]"
                asp-route-filterUserRecibe="@ViewData["filterUserRecibe"]"
                asp-route-filterDate1="@ViewData["filterDate1"]"
                asp-route-filterDate2="@ViewData["filterDate2"]"
                asp-route-filterEstado="@ViewData["filterEstado"]"
                asp-route-filterPalet="@ViewData["filterPalet"]">Siguiente</a>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="~/lib/flatpickr/es.js"></script>
    <script>
        (() => {
            if (!window.flatpickr) return;
            const calendars = new Map();
            document.querySelectorAll('.js-transfer-date').forEach(input => {
                const calendar = flatpickr(input, {
                    locale: 'es',
                    dateFormat: 'd/m/Y',
                    allowInput: true,
                    disableMobile: true,
                    clickOpens: true,
                    onClose(selectedDates, dateText, instance) {
                        if (dateText && !/^[0-9]{2}[/][0-9]{2}[/][0-9]{4}$/.test(dateText)) instance.clear();
                    }
                });
                calendars.set(input.id, calendar);
            });
            document.querySelectorAll('.date-picker-trigger').forEach(button => {
                button.addEventListener('click', () => calendars.get(button.dataset.dateTarget)?.open());
            });
        })();
    </script>
}
