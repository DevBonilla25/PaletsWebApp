@using X.PagedList
@using X.PagedList.Mvc.Core
@using X.PagedList.Web.Common
@model IPagedList<PaletsWebApp.ViewModels.PaletVM>
@{
    ViewData["Title"] = "Lista de Pallets";
}

<div class="container-fluid">
    <a class="btn btn-primary mb-1" asp-action="Create" asp-controller="Palets">Adicionar Pallet</a>
    <div class="card">
        <div class="card-header bg-primary">
            <h4 class="card-title text-white">Lista de Pallets</h4>
        </div>
        <div class="card-body" style="background-color:lightgray;">
            @foreach (var palet in Model)
            {
                <div class="rounded mb-4 bg-white p-2">
                    <div class="row">
                        
                        <div class="col-5 d-flex justify-content-center flex-column">
                            <h4 style="font-size:1.5rem; font-weight:bolder;" class="text-primary fw-bold">@palet.Descripcion</h4>
                            <label>Fecha creación</label>
                            <p>@palet.FechaCreacion</p>
                        </div>
                        <div class="col-5 d-flex justify-content-center flex-column">
                            <label>Estatus</label>
                            <p>@palet.Estado</p>
                        </div>
                        <div class="col-5 text-right d-flex justify-content-center flex-column">
                            <label>Usuario</label>
                            <h5 style="font-size:1rem;" class="fw-bold">@palet.ApplicationUserName</h5>
                        </div>

                        
                        <div class="one">
                            <a class="btn btn-outline-success"
                               asp-controller="Palets" 
                               asp-action="Editar" 
                               asp-route-id="@palet.Id" 
                               method="post">
                                Editar
                            </a>

                        </div>
                        

                    </div>
                </div>
            }
        </div>
        <div class="card-footer">
            Page @(Model?.PageCount < Model?.PageNumber ? 0 : Model?.PageNumber) of @Model?.PageCount
            @Html.PagedListPager(Model,page => Url.Action("Index",
            new { page, sortOrder = ViewBag.CurrentSort, currentFilter = ViewBag.CurrentFilter }),
            new PagedListRenderOptions()
            {
            ContainerDivClasses = new List<string> {"blog","navigation"},
            UlElementClasses = new List<string> {"pagination"},
            LiElementClasses = new List<string> {"page-item","page-link"},
            ActiveLiElementClass =  "active",
            })
        </div>
    </div>
</div>