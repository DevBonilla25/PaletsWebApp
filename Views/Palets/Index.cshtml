@using Microsoft.AspNetCore.Identity;
@using PaletsWebApp.Utilites;
@inject UserManager<ApplicationUser> _userManager;

@model PaginatedList<PaletsWebApp.Models.View_Palet>
@{
    ViewData["Title"] = "Lista de Palets";

    var loggedInUser = _userManager.Users?.FirstOrDefault(x => x.UserName == User.Identity!.Name);

    bool isAdmin = false;
    if (loggedInUser != null && await _userManager.IsInRoleAsync(loggedInUser, "Admin"))
    {
        isAdmin = true;
    }

    string currFilterEstado = ViewData["filterEstado"]?.ToString() ?? "-1";

    
}

<div class="container-fluid">

    @if (isAdmin)
    {
        <a class="btn btn-primary mb-1" asp-action="Create" asp-controller="Palets">
            <span class="bi-plus" style="margin-right:5px; font-weight: bold; "></span>
            Nuevo
        </a>
    }

    <div class="card">

        <div class="card-header bg-primary">
            <div class="row">
                <div class="col-9">
                    <h4 class="card-title text-white" style="width:fit-content; float:left">Pallets</h4>
                    
                    <div class="dv-ct-palets">
                        <b>Disponibles:</b> @ViewBag.ct_disponibles
                        <b>Reclamados:</b> @ViewBag.ct_reclamados
                        <b>, Transferencia:</b> @ViewBag.ct_en_transfer
                        <b>, Baja:</b> @ViewBag.ct_de_baja
                    </div>
                    

                </div>
                <div class="col-3 ">
                    <button type="button" class="btn btn-default btn-filter" onclick="$('#myFilterCollapse').collapse('toggle');">
                        <span class="bi-filter" style="margin-right:5px;"></span>Filtro
                    </button>

                </div>
            </div>

        </div>

        <div class="one collapse" id="myFilterCollapse">

            <form asp-action="Index" method="get">

                <input type="hidden" id="hd_show_filter" name="showFilter" />

                <div class="row">

                    <div class="col-6">
                        <label>Descripción:</label>
                        <input type="text" name="sDescripcion" value="@ViewData["filterDescripcion"]" class="form-control" autocomplete="off" />
                    </div>

                    <div class="col-6">
                        <label>Usuario:</label>
                        <input type="text" name="sUser" value="@ViewData["filterUser"]" class="form-control" autocomplete="off" />
                    </div>
                   
                </div>

                <div class="row">
                    <div class="col-6">
                        <label>Estado</label>

                        <select class="form-select" name="sEstado" value="@ViewData["filterEstado"]">
                            @if (@currFilterEstado == "-1")
                            {
                                <option value="-1" selected>-cualquiera-</option>
                            }
                            else
                            {
                                <option value="-1">-cualquiera-</option>
                            }
                            @if (@currFilterEstado == "1")
                            {
                                <option value="1" selected>Disponible</option>
                            }
                            else
                            {
                                <option value="1">Disponible</option>
                            }
                            @if (@currFilterEstado == "2")
                            {
                                <option value="2" selected>En transferencia</option>
                            }
                            else
                            {
                                <option value="2">En transferencia</option>
                            }
                            @if (@currFilterEstado == "3")
                            {
                                <option value="3" selected>Dado de baja</option>
                            }
                            else
                            {
                                <option value="3">Dado de baja</option>
                            }

                        </select>
                    </div>
                    <div class="col-6 mt-3 text-center">



                        <input type="submit"
                               class="btn  btn-outline-primary"
                               style="float: left; margin-left: 0px;"
                               value="Aplicar Filtro" />

                        <a asp-action="Index"
                           class="lnk-quitar-filtro">Quitar Filtro</a>


                    </div>
                </div>

            </form>

        </div>

        <div class="card-body" style="background-color:lightgray;">

            @foreach (var palet in Model)
            {
                <div class="rounded mb-4 bg-white p-2">
                    <div class="row">

                        <div class="one">
                            <span style="font-size:1.1rem; font-weight:bolder;" class="text-primary fw-bold">@palet.Descripcion</span>
                        </div>


                        <div class="col-6 d2-flex justify-content-center flex-column">

                            <label style="width: 110px;">Fecha creación:</label>
                            <span class="bfield">@Utils.FormatDate(palet.FechaCreacion)</span>

                        </div>

                        <div class="col-6 d2-flex justify-content-center flex-column">
                            <label>Estatus:</label>
                            <span class="badge @Utils.BadgePalet(palet.DescEstado!)">@palet.DescEstado</span>
                        </div>

                        <div class="col-6 d2-flex justify-content-center flex-column">
                            <label style="width: 110px; float:left;">Usuario:</label>
                            <span class="bfield">@palet.UserFullName</span>
                        </div>


                        <div class="one" style="padding-top: 15px;">


                            @if (isAdmin)
                            {
                                <a class="btn btn-outline-primary"
                                    asp-controller="Palets"
                                    asp-action="Editar"
                                    asp-route-id="@palet.Id"
                                    method="post">
                                    Editar
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-outline-primary"
                                    asp-controller="Palets"
                                    asp-action="Editar"
                                    asp-route-id="@palet.Id"
                                    method="post">
                                    Detalles
                                </a>
                            }


                            

                        </div>

                    </div>
                </div>
            }

        </div>



    </div>
</div>


@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<div class="row dv-pager">

    <div class="col-8">
        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           asp-route-filterUser="@ViewData["filterUser"]"
           asp-route-filterDescripcion="@ViewData["filterDescripcion"]"
           asp-route-filterEstado="@ViewData["filterEstado"]"
           class="btn btn-outline-primary @prevDisabled">
            Anterior
        </a>
        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           asp-route-filterUser="@ViewData["filterUser"]"
           asp-route-filterDescripcion="@ViewData["filterDescripcion"]"
           asp-route-filterEstado="@ViewData["filterEstado"]"
           class="btn btn-outline-primary @nextDisabled">
            Siguiente
        </a>
    </div>

    <div class="col-4">
        Pagina @(Model.PageIndex) de @(Model.TotalPages)
    </div>

</div>


