@using Microsoft.AspNetCore.Identity
@using PaletsWebApp.Utilites
@inject UserManager<ApplicationUser> UserManager
@model PaginatedList<PaletsWebApp.Models.View_Palet>

@{
    ViewData["Title"] = "Pallets";
    var user = await UserManager.GetUserAsync(User);
    var roles = user == null ? new List<string>() : (await UserManager.GetRolesAsync(user)).ToList();
    var isAdmin = roles.Contains("Admin") || roles.Contains("Supervisor");
    ViewData["CanManagePalets"] = isAdmin;
    var currentStatus = ViewData["filterEstado"]?.ToString() ?? "-1";
    var pageSize = (int?)ViewData["PageSize"] ?? 15;
    var rowNumber = ((Model.PageIndex - 1) * pageSize) + 1;
}

<div class="page-header">
    <div><h1 class="page-title">Pallets</h1><p class="page-subtitle">Inventario disponible según tus permisos.</p></div>
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-2"></i>Nuevo pallet</a>
    }
</div>

<form asp-action="Index" method="get" class="surface filter-panel">
    <input type="hidden" name="pageSize" value="@pageSize" />
    <div class="filter-grid">
        <div><label>Descripción</label><input class="form-control" name="sDescripcion" value="@ViewData["filterDescripcion"]"
            placeholder="Buscar pallet..." /></div>
        <div><label>Usuario</label><input class="form-control" name="sUser" value="@ViewData["filterUser"]" placeholder="Nombre del usuario..." /></div>
        <div>
            <label>Estado</label>
            <select class="form-select" name="sEstado">
                <option value="-1">Todos</option>
                <option value="1" selected="@(currentStatus == "1")">Disponible</option>
                <option value="2" selected="@(currentStatus == "2")">En transferencia</option>
                <option value="3" selected="@(currentStatus == "3")">Dado de baja</option>
            </select>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Buscar</button>
            <a class="btn btn-outline-secondary" asp-action="Index" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
        </div>
    </div>
</form>

<div class="surface data-card">
    <div class="table-responsive pallet-table-view">
        <table class="table align-middle">
            <thead><tr><th>#</th><th>Pallet</th><th>Propietario</th><th>Estado</th><th>Fecha de creación</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="row-index">@rowNumber</td>
                        <td><strong>@item.Descripcion</strong><small class="d-block text-muted">ID #@item.Id</small></td>
                        <td>@item.UserFullName</td>
                        <td><span class="badge @Utils.BadgePalet(item.DescEstado ?? "")">@item.DescEstado</span></td>
                        <td>@Utils.FormatDate(item.FechaCreacion)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@item.Id">
                                <i class="bi @(isAdmin ? "bi-pencil" : "bi-eye") me-1"></i>@(isAdmin ? "Editar" : "Detalles")
                            </a>
                            @if (isAdmin)
                            {
                                <a class="btn btn-sm btn-history"
                                    asp-controller="Transfers"
                                    asp-action="Index"
                                    asp-route-palletId="@item.Id" title="Ver historial de transferencias">
                                    <i class="bi bi-clock-history me-1"></i>Historial
                                </a>
                            }
                        </td>
                    </tr>
                    rowNumber++;
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6"><div class="empty-state"><i class="bi bi-inbox"></i>No se encontraron pallets.</div></td></tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_PalletMobileList" model="Model" view-data="ViewData" />
    <div class="pagination-bar">
        <div class="page-size">
            <span>Mostrar</span>
            <select class="form-select form-select-sm" data-page-size>
                @foreach (var size in new[] { 15, 25, 50 })
                {
                    <option value="@size" selected="@(pageSize == size)">@size</option>
                }
            </select>
            <span>registros</span>
        </div>
        <div class="btn-group">
            <a class="btn btn-outline-primary @(!Model.HasPreviousPage ? "disabled" : "")"
                asp-action="Index"
                asp-route-pageNumber="@(Model.PageIndex - 1)"
                asp-route-pageSize="@pageSize"
                asp-route-filterUser="@ViewData["filterUser"]"
                asp-route-filterDescripcion="@ViewData["filterDescripcion"]"
                asp-route-filterEstado="@ViewData["filterEstado"]">Anterior</a>
            <span class="btn btn-light disabled">@Model.PageIndex / @Math.Max(1, Model.TotalPages)</span>
            <a class="btn btn-outline-primary @(!Model.HasNextPage ? "disabled" : "")"
                asp-action="Index"
                asp-route-pageNumber="@(Model.PageIndex + 1)"
                asp-route-pageSize="@pageSize"
                asp-route-filterUser="@ViewData["filterUser"]"
                asp-route-filterDescripcion="@ViewData["filterDescripcion"]"
                asp-route-filterEstado="@ViewData["filterEstado"]">Siguiente</a>
        </div>
    </div>
</div>
